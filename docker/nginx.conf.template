# Public entry point. Serves the dashboard and proxies only the Convex sync
# WebSocket, which is all Luma and the dashboard use, plus the lock screen
# webhooks. Every other /api/ path (deploying code, exports, environment
# variables, ...) is refused here; the admin UI reaches those through its own
# local-only proxy.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # /api/sync (Luma's Android client) and /api/<version>/sync (JS client).
    location ~ ^/api/([^/]+/)?sync$ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Sync connections stay open indefinitely.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    location /api/ {
        return 404;
    }

    # Lock screen webhooks (convex/http.ts), served by the backend's HTTP
    # action port. Nothing else on that port is exposed.
    location ~ ^/hooks/[A-Za-z0-9_-]+$ {
        limit_except POST DELETE {
            deny all;
        }
        client_max_body_size 4k;
        proxy_pass http://${SITE_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /version {
        proxy_pass http://${BACKEND_UPSTREAM};
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
