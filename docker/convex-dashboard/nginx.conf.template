# Local-only admin entry point: serves Convex's admin UI and proxies the
# full Convex API to the backend. Sign in with this same URL
# (e.g. http://127.0.0.1:6791) as the deployment URL.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 6791;
    # Look the backend up per request rather than once at startup, so nginx
    # starts before the backend's name resolves and follows it when its
    # address changes (e.g. after a redeploy).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend_upstream ${BACKEND_UPSTREAM};
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
        client_max_body_size 512m;
    }

    location = /version {
        proxy_pass http://$backend_upstream;
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
