# URL the phone and the browser use to reach the backend. It must be
# reachable from your phone: a LAN address (http://192.168.1.20:3210) or,
# preferably, an HTTPS domain behind a reverse proxy
# (https://luma-api.example.com -> port 3210). Enter the same URL under
# Server on Luma's login screen.
PUBLIC_BACKEND_URL=http://127.0.0.1:3210
# Convex HTTP actions origin. Unused by Luma, but the backend requires it.
PUBLIC_SITE_URL=http://127.0.0.1:3211

BACKEND_PORT=3210
WEB_PORT=8080
CONVEX_ADMIN_PORT=6791

# Images to run. Pin IMAGE_TAG to a release (e.g. 0.2.0) for stable updates.
IMAGE_PREFIX=ghcr.io/vbbot
IMAGE_TAG=latest
