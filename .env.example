# URL the phone and the browser use to reach the Convex backend. It must be
# reachable from your phone: a LAN address (http://192.168.1.20:3210) or,
# preferably, an HTTPS domain behind a reverse proxy
# (https://luma-api.example.com -> backend:3210). This is the URL you enter
# under Server on Luma's login screen.
PUBLIC_BACKEND_URL=http://127.0.0.1:3210
# Convex HTTP actions origin. Unused by Luma, but the backend requires it.
PUBLIC_SITE_URL=http://127.0.0.1:3211

# Convex backend release to build from:
# https://github.com/get-convex/convex-backend/releases
CONVEX_RELEASE=precompiled-2026-10-10-bb95347

BACKEND_PORT=3210
WEB_PORT=8080
CONVEX_DASHBOARD_PORT=6791

# Filled in by ./setup.sh. Keep both secret: the admin key grants full
# access to all data.
INSTANCE_SECRET=
CONVEX_ADMIN_KEY=
