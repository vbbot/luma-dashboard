# Public URL of the dashboard, also entered under Server on Luma's login
# screen. Put port WEB_PORT behind an HTTPS reverse proxy with WebSockets
# enabled. On a home network without a proxy: http://192.168.1.20:8080
PUBLIC_URL=https://luma.example.com

# Required. Root secret of the backend; admin keys are derived from it.
# Generate with: openssl rand -hex 32
# Keep it private and do not change it once the backend has data.
INSTANCE_SECRET=

WEB_PORT=8080
# Admin UI, bound to 127.0.0.1 on the host.
CONVEX_ADMIN_PORT=6791

# Images to run. Pin IMAGE_TAG to a release (e.g. 0.2.0) for stable updates.
IMAGE_PREFIX=ghcr.io/vbbot
IMAGE_TAG=latest
