# Public URL of the dashboard. The backend is served from the same URL, and
# it is also what you enter under Server on Luma's login screen, so it must
# be reachable from your phone: a LAN address (http://192.168.1.20:8080) or,
# preferably, an HTTPS domain behind a reverse proxy
# (https://luma.example.com -> port 8080, with WebSockets enabled).
PUBLIC_URL=http://127.0.0.1:8080

WEB_PORT=8080
CONVEX_ADMIN_PORT=6791

# Images to run. Pin IMAGE_TAG to a release (e.g. 0.2.0) for stable updates.
IMAGE_PREFIX=ghcr.io/vbbot
IMAGE_TAG=latest
